<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Compile with the installed SDK against RimWorld 1.7's .NET 10 assemblies. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>embedded</DebugType>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\RimWorld</RimWorldDir>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(RimWorldDir)\..\..\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HarmonyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(RimWorldDir)\System*.dll" Exclude="$(RimWorldDir)\System.IO.Compression.Native.dll"><Private>false</Private></Reference>
    <Reference Include="$(RimWorldDir)\Brutal*.dll"><Private>false</Private></Reference>
    <Reference Include="$(RimWorldDir)\Waylith*.dll" Exclude="$(RimWorldDir)\waylithaudio.dll"><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RimWorldDir)\UnityStubs.dll')" Text="RimWorld 1.7 is required at RimWorldDir." />
    <Error Condition="!Exists('$(HarmonyPath)')" Text="RimWorld 1.7 Harmony is required at HarmonyPath." />
  </Target>
</Project>
